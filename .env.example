# Set VITE_FIREBASE_USE_EMULATORS=true for local Firebase emulators.
VITE_FIREBASE_ENABLED=true
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-your-measurement-id
# Never put OPENAI_API_KEY or Firebase service account credentials here.
# Workflow v0.7 draft screens. Production also needs VITE_WORKFLOW_V07_ALLOW_PRODUCTION=true.
VITE_WORKFLOW_V07_ENABLED=false
VITE_WORKFLOW_V07_ALLOW_PRODUCTION=false
