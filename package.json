{
  "name": "cmg-formwork-design",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-cmg-formwork --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "firebase emulators:exec --project demo-cmg-formwork --only auth,firestore,functions \"node scripts/test-functions.mjs\"",
    "emulators": "npm run build --workspace functions && firebase emulators:start --project demo-cmg-formwork",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp:start": "node mcp/dist/mcp/server.js",
    "test:mcp": "npm run mcp:build && node scripts/test-mcp.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.27.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^4.0.0",
    "zod": "4.6.7"
  }
}
